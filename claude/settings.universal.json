{
  "cleanupPeriodDays": 14,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_SUBAGENT_PROMPT_CACHE_TTL": "1h",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_BUG_COMMAND": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Notion"
    },
    {
      "serverName": "claude.ai monday.com"
    },
    {
      "serverName": "claude.ai Linear"
    },
    {
      "serverName": "claude.ai Intercom"
    },
    {
      "serverName": "claude.ai HubSpot"
    },
    {
      "serverName": "claude.ai Canva"
    },
    {
      "serverName": "claude.ai Box"
    },
    {
      "serverName": "claude.ai Atlassian"
    }
  ],
  "workflowSizeGuideline": "small",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 200000
    },
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-haiku-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-4-6": {
      "effortLevel": "xhigh"
    },
    "claude-opus-4-8": {
      "effortLevel": "low"
    },
    "claude-sonnet-4-6": {
      "effortLevel": "low"
    },
    "claude-fable-5-2": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 300000,
  "promptSuggestionEnabled": false,
  "autoContinueAtUsageLimit": true,
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "session-report@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Read(**/.env.local)"
    ]
  }
}